{
  "name": "review-pinger",
  "private": true,
  "scripts": {
    "dev": "pnpm sweep && pnpm --filter @review-pinger/desktop tauri dev",
    "sweep": "if command -v cargo-sweep >/dev/null; then cargo sweep --time 14 >/dev/null; cargo sweep --installed >/dev/null; fi; true",
    "tauri": "pnpm --filter @review-pinger/desktop tauri",
    "web": "pnpm --filter @review-pinger/web dev",
    "build": "pnpm --filter @review-pinger/desktop build"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.6.0"
}
