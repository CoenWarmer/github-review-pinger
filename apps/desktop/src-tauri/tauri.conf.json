{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Review Pinger",
  "version": "0.6.4",
  "identifier": "dev.coenwarmer.reviewpinger",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Review Pinger",
        "width": 380,
        "height": 520,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "category": "DeveloperTool",
    "shortDescription": "Your open GitHub pull requests and their review status",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4ODMxNEVGNDg5NDg0RUMKUldUc2hKUkk3eFNET0JEek42bXQ4REJiclk2dDQwbDF1RDlMN2JDazN1YlpKUU50RWswV0FTUmYK",
      "endpoints": [
        "https://github.com/CoenWarmer/github-review-pinger/releases/latest/download/latest.json"
      ]
    }
  }
}
